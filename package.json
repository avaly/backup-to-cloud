{
  "name": "backup-to-cloud",
  "version": "4.7.1",
  "description": "A simple backup tool which uploads encrypted files to S3",
  "author": "Valentin Agachi",
  "scripts": {
    "coverage": "rm -rf .nyc_output/ coverage/ bin/.backup-to-cloud.lock && BACKUP_ENV=test nyc --reporter=text --reporter=lcov mocha",
    "lint": "eslint .",
    "prepare": "husky",
    "pretty": "prettier --ignore-unknown --write \"**/*\"",
    "pretty-ci": "prettier --ignore-unknown --check \"**/*\"",
    "test": "rm -f bin/.backup-to-cloud.lock && BACKUP_ENV=test mocha"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "backup-decrypt": "./bin/backup-decrypt",
    "backup-restore": "./bin/backup-restore",
    "backup-to-cloud": "./bin/backup-to-cloud",
    "backup-verify": "./bin/backup-verify"
  },
  "files": [
    "LICENSE",
    "config.sample.js",
    "lib/",
    "bin/"
  ],
  "dependencies": {
    "better-sqlite3": "12.9.0",
    "pretty-bytes": "7.1.0",
    "slackr": "1.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/js": "10.0.1",
    "chai": "6.2.2",
    "eslint": "10.2.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "md5-file": "5.0.0",
    "mocha": "11.7.5",
    "nyc": "18.0.0",
    "prettier": "3.8.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/avaly/backup-to-cloud.git"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        2,
        "always",
        [
          "sentence-case"
        ]
      ]
    }
  }
}
