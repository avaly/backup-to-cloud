{
  "name": "backup-to-cloud",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "version": "6.0.1",
  "description": "A simple backup tool which uploads encrypted files to S3",
  "author": "Valentin Agachi",
  "type": "module",
  "scripts": {
    "build:sea": "node scripts/build-sea.js && node --build-sea dist/sea/sea-config.json",
    "lint": "eslint .",
    "prepare": "husky",
    "pretty": "prettier --ignore-unknown --write \"**/*\"",
    "pretty-ci": "prettier --ignore-unknown --check \"**/*\"",
    "test:sea": "pnpm build:sea && BACKUP_ENV=test node test/sea/sea.test.js",
    "test": "rm -f tmp/test/locks/*.lock && BACKUP_ENV=test node --test --test-concurrency=1 --test-timeout=10000 test/*-test.js",
    "test:coverage": "rm -rf coverage/ && rm -f tmp/test/locks/*.lock && mkdir -p coverage && BACKUP_ENV=test node --test --experimental-test-coverage --test-concurrency=1 --test-timeout=10000 --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info test/*-test.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "backup-to-cloud": "bin/backup-to-cloud"
  },
  "dependencies": {
    "better-sqlite3": "12.10.0",
    "commander": "15.0.0",
    "pretty-bytes": "7.1.0",
    "slackr": "1.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.1",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "md5-file": "5.0.0",
    "prettier": "3.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avaly/backup-to-cloud.git"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        2,
        "always",
        [
          "sentence-case"
        ]
      ]
    }
  }
}
