#!/usr/bin/env node

const path = require('path');

const Backuper = require('../lib/Backuper');
const ConfigChecker = require('../lib/ConfigChecker');
const DB = require('../lib/DB');
const Scanner = require('../lib/Scanner');
const package = require('../package.json');
const utils = require('../lib/utils');

const LOCK_FILE = path.join(__dirname, '.backup-to-cloud.lock');

let db;

function usage() {
  console.log(`${package.name} v${package.version}

Usage: ${__filename} OPTIONS

Options:
	--check-config
	--only-scan
	--skip-scan
	--random-order
	--ignore-lock
	--verbose
	--dry
	--help
`);
}

async function main() {
  if (!utils.acquireLock(LOCK_FILE)) {
    return;
  }

  utils.log(`${package.name} v${package.version}`);

  if (utils.hasFlag('check-config')) {
    const configChecker = new ConfigChecker();
    try {
      await configChecker.check();
      utils.log('Config seems in order!');
    } catch (err) {
      utils.log('Config check failed:');
      utils.log(err.message || err);
    }
    finish();
    return;
  }

  utils.log('Starting...');
  if (utils.DRY_RUN) {
    utils.log('This is a DRY run! No changes/uploads will be made.');
  }

  db = new DB();
  db.initialize();

  if (!utils.hasFlag('skip-scan')) {
    const scanner = new Scanner(db);
    scanner.scan();
  }

  if (!utils.hasFlag('only-scan')) {
    const backuper = new Backuper(db, {
      random: utils.hasFlag('random-order'),
    });

    try {
      const result = await backuper.start();
      utils.log('Backup result', result);
    } catch (err) {
      utils.log('Backup error', err);
    }
    await backuper.finish();
  }

  finish();
}

function finish() {
  if (db) {
    db.close();
    utils.log('Finished!');
  }
  utils.releaseLock(LOCK_FILE);
}

if (utils.hasFlag('help')) {
  usage();
} else {
  main().catch((err) => {
    utils.log(`Error: ${err.message}`);
    finish();
    process.exit(1);
  });
}
