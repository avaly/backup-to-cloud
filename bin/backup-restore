#!/usr/bin/env node

const path = require('path');

const Restorer = require('../lib/Restorer');
const package = require('../package.json');
const utils = require('../lib/utils');

const LOCK_FILE = path.join(__dirname, '.backup-restore.lock');

function usage() {
  console.log(`${package.name} v${package.version}

Usage: ${__filename} [OPTIONS] REMOTE_DIR_OR_FILE

Options:
	--output OUTPUT_DIR_OR_FILE [required]
	--max-size BYTES            Restore only files <= to this size in bytes
	--test                      Restore only one random file
	--ignore-lock
	--yes
	--verbose
	--dry
	--help

Examples:
	${__filename} --output /foo/ /remote/dir/file1.txt
		Will restore s3://BUCKET/remote/dir/file1.txt to /foo/remote/dir/file1.txt

	${__filename} --output /foo/ /remote/
		Will restore s3://BUCKET/remote/dir/file1.txt to /foo/remote/dir/file1.txt
		Will restore s3://BUCKET/remote/other/file2.txt to /foo/remote/other/file2.txt

	${__filename} --output /foo/ --test /remote/
		Will restore a random file with the prefix s3://BUCKET/remote/ to /foo/remote/
`);
}

async function main() {
  if (!utils.acquireLock(LOCK_FILE)) {
    return;
  }

  utils.log(`${package.name} v${package.version}`);
  if (utils.DRY_RUN) {
    utils.log('This is a DRY run! No changes/uploads will be made.');
  }

  const input = process.argv.pop();
  const output = path.resolve(utils.getOption('output'));
  let finalResult;

  const restorer = new Restorer();

  try {
    const result = await restorer.start(input, output);
    utils.debug('Restorer result:', result);
    finalResult = result;
  } catch (err) {
    utils.log('Restorer error:', err);
    finalResult = 'FAIL';
  }

  restorer.finish();
  finish();

  if (finalResult && finalResult.includes('FAIL')) {
    process.exit(1);
  }
}

function finish() {
  utils.releaseLock(LOCK_FILE);
}

if (utils.hasFlag('help') || !utils.getOption('output')) {
  usage();
} else {
  main().catch((err) => {
    utils.log(`Error: ${err.message}`);
    finish();
    process.exit(1);
  });
}
