#!/usr/bin/env node

import { fileURLToPath } from 'node:url';

import pkg from '../lib/package.js';
import utils from '../lib/utils.js';
import Verifier from '../lib/Verifier.js';

const __filename = fileURLToPath(import.meta.url);

function usage() {
  console.log(`${pkg.name} v${pkg.version}

Usage: ${__filename} OPTIONS

Options:
	--dry
	--verbose
	--help
`);
}

async function main() {
  utils.log(`${pkg.name} v${pkg.version}`);
  if (utils.DRY_RUN) {
    utils.log('This is a DRY run! No changes/uploads will be made.');
  }

  const verifier = new Verifier();

  try {
    await verifier.start(utils.TEST ? utils.getOption('aws-ls-mock') : null);
  } catch (err) {
    utils.log('Verifier error:', err);

    verifier.stop();

    process.exit(1);
  }
}

if (utils.hasFlag('help')) {
  usage();
} else {
  main();
}
